Bootstrap: docker

From: library/centos:7

%labels
    Tools for calling variant from fastq files
%help
    This image contains tools for imputing the genotypes of individuals.
    Tools are designed to be available globally at the top level for use with
    a snakemake workflow.

%runscript
    exec "$@"

%environment
    export PATH=/opt/wgseqtl/bin:/opt/snpEff/exec:$PATH
    export PICARD=/opt/picard.jar
    export TRIMMOMATIC=/opt/Trimmomatic-3.9/trimmomatic-0.39.jar
    export TRIMMOMATIC_ADAPTERS=/opt/Trimmomatic-3.9/adapters
    export LC_ALL=en_US.utf8
    export LANG=en_US.utf8

%post
    BEDTools_VERSION=2.30.0
    BWA_VERSION=0.7.17
    SAMTOOLS_VERSION=1.16
    GATK_VERSION=4.2.6.1
    FASTQC_VERSION=0.11.9
    TRIM_GALORE_VERSION=0.6.7
    MULTIQC_VERSION=1.13
    SHAPEIT4_VERSION=4.2.2

    echo "Updating System"
    yum clean all
    yum makecache
    yum install epel-release -y
    yum update -y

    # Common utilities
    yum install wget tar rsync sudo zip unzip bzip2 xz epel-release  -y
    yum install gcc zlib-devel make -y
    yum install jq -y # json parser

    # create mount points for gardner
    # mkdir /project2/haky/Data/TFXcan
    # mkdir /scratch

    ###########################
    # BWA ${BWA_VERSION}
    cd /opt
    wget https://sourceforge.net/projects/bio-bwa/files/bwa-${BWA_VERSION}.tar.bz2 --no-check-certificate

    tar xjvf bwa-${BWA_VERSION}.tar.bz2
    cd bwa-${BWA_VERSION}
    make
    ln -s /opt/bwa-${BWA_VERSION}/bwa /usr/bin/bwa

    rm /opt/bwa-${BWA_VERSION}.tar.bz2

    ###########################
    # SAMtools 1.16.1
    yum group install "Development Tools" -y
    yum install ncurses-devel bzip2-devel xz-devel curl-devel -y

    cd /opt
    wget https://sourceforge.net/projects/samtools/files/samtools/${SAMTOOLS_VERSION}/samtools-${SAMTOOLS_VERSION}.1.tar.bz2 --no-check-certificate
    tar xjvf samtools-${SAMTOOLS_VERSION}.1.tar.bz2
    cd samtools-${SAMTOOLS_VERSION}.1
    make
    ln -s /opt/samtools-${SAMTOOLS_VERSION}.1/samtools /usr/bin/samtools
    rm /opt/samtools-${SAMTOOLS_VERSION}.1.tar.bz2

    ###############################
    # shapeit4
    cd /opt
    wget https://github.com/odelaneau/shapeit4/archive/refs/tags/v${SHAPEIT4_VERSION}.tar.gz --no-check-certificate
    tar xjvf shapeit4-{SHAPEIT_VERSION}.tar.gz
    cd shapeit4-{SHAPEIT_VERSION}
    make
    ln -s /opt/shapeit4-{SHAPEIT_VERSION}/shapeit4 /usr/bin/shapeit4
    rm /opt/shapeit4-{SHAPEIT_VERSION}.tar.gz

    ###########################
    # R 3.6 and ExomeDepth
    ##########################
    yum install R-devel -y

    ###########################
    # Picard tools requires java and R
    ###########################
    yum install java-11-openjdk-headless -y

    echo "Installing Picard Tools"
    cd /opt
    wget --quiet https://github.com/broadinstitute/picard/releases/download/2.27.5/picard.jar

    ###########################
    # Trimmomatic
    ###########################
    wget --quiet http://www.usadellab.org/cms/uploads/supplementary/Trimmomatic/Trimmomatic-0.39.zip
    unzip Trimmomatic-0.39.zip
    cd Trimmomatic-0.39

    ###########################
    # GATK4
    cd /opt
    wget https://github.com/broadinstitute/gatk/releases/download/${GATK_VERSION}/gatk-${GATK_VERSION}.zip
    unzip gatk-${GATK_VERSION}.zip
    ln -s /opt/gatk-${GATK_VERSION}/gatk /usr/bin/gatk
    rm /opt/gatk-${GATK_VERSION}.zip

    ###########################
    # FastQC requires perl
    yum install perl-core -y
    yum install fontconfig urw-fonts -y

    echo "Installing FastQC"
    cd /opt
    wget https://www.bioinformatics.babraham.ac.uk/projects/fastqc/fastqc_v0.11.9.zip --no-check-certificate
    unzip fastqc_v0.11.9.zip
    chmod a+x FastQC/fastqc
    ln -s /opt/FastQC/fastqc /usr/bin/fastqc
    rm fastqc_v0.11.9.zip

    ##########################
    # Python 3.9 and venv
    sudo yum install gcc openssl-devel bzip2-devel libffi-devel zlib-devel -y
    cd /opt
    wget https://www.python.org/ftp/python/3.9.7/Python-3.9.7.tgz
    tar xvf Python-3.9.7.tgz
    cd Python-3.9.7/
    ./configure --enable-optimizations
    sudo make altinstall
    rm /opt/Python-3.9.7.tgz

    cd /opt
    python3.9 -m venv imputation-toolkit
    source imputation-toolkit/bin/activate
    pip install multiqc==1.13
    pip install pip -U
    pip install wheel
    pip install PyYAML==6.0
    pip install cutadapt==4.0

    # Install Trim Galore
    yum install pigz -y
    cd /opt
    curl -fsSL https://github.com/FelixKrueger/TrimGalore/archive/${TRIM_GALORE_VERSION}.tar.gz -o trim_galore.tar.gz
    tar xvzf trim_galore.tar.gz
    ln -s /opt/TrimGalore-${TRIM_GALORE_VERSION}/trim_galore /usr/bin/trim_galore
    rm /opt/trim_galore.tar.gz

    # Install seqkit
    cd /opt
    wget https://github.com/shenwei356/seqkit/releases/download/v2.2.0/seqkit_linux_386.tar.gz
    tar -zxvf seqkit_linux_386.tar.gz
    ln -s /opt/seqkit /usr/bin/seqkit
    rm seqkit_linux_386.tar.gz

    # Install bcftools
    yum install -y bcftools htslib-tools

    # # Install SnpSift and SnpEff
    # cd /opt
    # wget https://snpeff.blob.core.windows.net/versions/snpEff_latest_core.zip
    # unzip snpEff_latest_core.zip
    # rm /opt/snpEff_latest_core.zip
    # #/opt/snpEff/exec/snpeff download -v hg19
    # cd /opt/snpEff/exec
    # ln -s snpeff snpEff
    # ln -s snpsift SnpSift